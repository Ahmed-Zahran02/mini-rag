APP_NAME="mini-RAG"
APP_VERSION="0.1"

FILE_ALLOWED_TYPES = ["text/plain", "application/pdf"]
FILE_MAX_SIZE = 10

BASE_DIR = ""
DATA_DIR = ""

CHUNK_SIZE = 500000

DATABASE_URL = mongodb://localhost:27017
DATABASE_NAME = "mini-rag"

